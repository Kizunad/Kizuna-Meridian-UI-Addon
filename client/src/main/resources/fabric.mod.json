{
  "schemaVersion": 1,
  "id": "meridian_ui",
  "version": "${version}",
  "name": "Kizuna's Meridian UI Addon",
  "contact": {
    "homepage": "https://github.com/Kizunad/Kizuna-Meridian-UI-Addon",
    "sources": "https://github.com/Kizunad/Kizuna-Meridian-UI-Addon",
    "issues": "https://github.com/Kizunad/Kizuna-Meridian-UI-Addon/issues"
  },
  "icon": "assets/meridian_ui/icon.png",
